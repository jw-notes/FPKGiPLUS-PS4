# Everything here is either generated by the build, local to one machine, or
# development-only. A fresh clone still builds: see "Building from source" in
# README.md.

# Build output and packages (make, tools/build.sh, make art's helper)
build/
dist/
*.o
*.d
*.oelf
*.elf
*.prx
*.pkg
*.part
*.part.meta
*.part.chunks

# Python caches (tools/*.py)
__pycache__/
*.pyc

# Toolchain (installed per machine; see README) and download caches
tools/toolchain/
third_party/_downloads/

# Tests and their test-only tools (tests/tools/): kept in the development
# tree, never uploaded or released. tools/build.sh skips the native installer
# check when tests/ is absent.
tests/

# Logs, crash reports and console diagnostics
*.log
crash*.txt

# App data written when the desktop build runs from the project folder
/ContentJSONs/
/Covers/
/Downloads/
config.json
download-queue.json*
archive-session.json
wikidata-metadata.json
FPKGIPLUS-releases.json
content-imported

# Editors, AI tools and operating systems
.vscode/
.idea/
.vs/
.claude/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
