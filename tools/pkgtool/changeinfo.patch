+      // FPKGi+ patch: entries kept in a sce_sys subfolder, such as
+      // changeinfo/changeinfo.xml (the console's Update History).
+      foreach (var dir in project.RootDir.Dirs.Where(f => f.name == "sce_sys").First().Dirs.Where(d => d.name == "changeinfo"))
+      {
+        foreach (var file in dir.Files)
+        {
+          var name = dir.name + "/" + file.name;
+          if (!EntryNames.NameToId.ContainsKey(name)) continue;
+          pkg.Entries.Add(new FileEntry(EntryNames.NameToId[name], file.Write, (uint)file.Size));
+        }
+      }
       pkg.Digests.FileData = new byte[pkg.Entries.Count * Pkg.HASH_SIZE];
 
